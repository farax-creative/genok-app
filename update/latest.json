{"version": "0.1.56", "url": "https://genok.app/update/Genok-0.1.56.zip", "zip": "Genok-0.1.56.zip", "sha256": "dbc1c01b49d96757e9fb6a67c2203422e404d48b03053cf5c072263ce3128cea", "size": 83030095, "notes": ["Genok\uc5d0\uc11c \ubcf4\ub0b8 \ub9d0\uc774 \ub300\ud654 \ud654\uba74\uc5d0 \ub098\ud0c0\ub098\uc9c0 \uc54a\ub358 \ubb38\uc81c\ub97c \uace0\ucce4\uc5b4\uc694. \uc138\uc158\uc774 \uc77c\ud558\ub294 \uc911\uc5d0 \ubcf4\ub0b8 \ub9d0\ub3c4 \ubcf4\uc5ec\uc694", "\ub9d0\ud48d\uc120\uc758 \"\ubcf4\ub0c4\" \ud45c\uc2dc\ub97c \uc791\uc740 \uae00\uc528\ub85c \uc815\ub9ac\ud588\uc5b4\uc694", "\ud3f4\ub354\uac00 \uc9c0\uc6cc\uc9c4 \ud504\ub85c\uc81d\ud2b8\uc5d0\uc11c [\uc0c8 \uc138\uc158]\uc774 \"\uc791\uc5c5 \ud3f4\ub354\ub97c \ucc3e\uc9c0 \ubabb\ud588\uc5b4\uc694\"\ub85c \ub9c9\ud788\ub358 \ubb38\uc81c\ub97c \uace0\ucce4\uc5b4\uc694. \uc138\uc158\uc744 \uc5f4 \ub54c \ud3f4\ub354\ub97c \ub2e4\uc2dc \ub9cc\ub4e4\uc5b4\uc694", "\uc0c8\ub85c \uc124\uce58\ud55c PC\uc5d0\uc11c \ucc3d \uc704\ucabd\uc758 \ucd5c\uc18c\ud654\u00b7\ub2eb\uae30 \ubc84\ud2bc\uc774 \uc0ac\ub77c\uc9c0\uace0 \ucc3d\uc744 \ub04c \uc218 \uc5c6\ub358 \ubb38\uc81c\ub97c \uace0\ucce4\uc5b4\uc694", "\uc138\uc158 \ud558\ub098\uac00 \ub2f5\uc744 \uae30\ub2e4\ub9ac\uba74 \uadf8 \uc138\uc158\uc774 \ub9e1\uc558\ub358 \uc608\uc804 \uacb0\uacfc\ubb3c\uae4c\uc9c0 \ud55c\uaebc\ubc88\uc5d0 \"\ud655\uc778 \ud544\uc694\"\ub85c \ub118\uc5b4\uc624\ub358 \ubb38\uc81c\ub97c \uace0\ucce4\uc5b4\uc694. \ucd5c\uadfc 3\uc2dc\uac04 \uc548\uc5d0 \uc6c0\uc9c1\uc778 \uac83\ub9cc \ub118\uc5b4\uc640\uc694", "\uc138\uc158\uc774 \ucf1c\uc838 \uc788\ub2e4\ub294 \uc774\uc720\ub9cc\uc73c\ub85c \uc624\ub798\ub41c \uacb0\uacfc\ubb3c\uc774 \"\uc791\uc5c5 \uc911\"\uc5d0 \uc313\uc774\ub358 \ubb38\uc81c\ub97c \uace0\ucce4\uc5b4\uc694", "\ucf54\uba58\ud2b8 \uc544\uc774\ucf58\uc744 \ubc14\uafe8\uc5b4\uc694", "\uae30\ubcf8 \uc0d8\ud50c\uc744 Genok \ub85c\uace0 \ud0c0\uc774\ud2c0 \uc601\uc0c1\uc73c\ub85c \ubc14\uafe8\uc5b4\uc694. \uc774\ubbf8 \ub123\uc5b4 \ub454 \uc0d8\ud50c\uc740 \uadf8\ub300\ub85c\uc608\uc694", "\ubc1d\uc740 \ud654\uba74, \ud3f0 \ud654\uba74, \uc601\uc5b4 \ud654\uba74\uc758 \uc5b4\uae0b\ub09c \uacf3\uc744 \ub2e4\ub4ec\uc5c8\uc5b4\uc694"], "sig": "IJhaVe2VxrSWn9rPDnPHCcEZSlacooLTmajTisP2yaKfH3K3O7Ar48rpBh-lqfUwbWoM-YuRzlkykb-DLikECA"}