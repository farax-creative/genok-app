{"version": "0.1.53", "url": "https://github.com/farax-creative/genok-app/releases/download/v0.1.53/Genok-0.1.53.zip", "zip": "Genok-0.1.53.zip", "sha256": "f69ba1b5c6cc6eab702bea81ff414446823158d4b305cdb095d55df091c5b552", "size": 110885945, "notes": ["\uc54c\ub9bc \ubc1b\uc744 \uc885\ub958\ub97c \uace0\ub97c \uc218 \uc788\uc5b4\uc694. \uaebc \ub454 \uc885\ub958\ub294 \ubaa9\ub85d\uacfc \uc22b\uc790\uc5d0\uc11c \uc0ac\ub77c\uc838\uc694", "\ud655\uc778\uc774 \ud544\uc694\ud55c \uacb0\uacfc\ubb3c\uc774 \uba3c\uc800 \ubcf4\uc774\uace0, \"\uc804\uccb4\"\ub294 \ub9e8 \ub4a4\ub85c \uac14\uc5b4\uc694", "\ucd5c\uc2e0\uc21c \u00b7 \ud504\ub85c\uc81d\ud2b8\ubcc4\ub85c \ubc14\ub85c \ubc14\uafd4 \ubcfc \uc218 \uc788\uc5b4\uc694", "\uc67c\ucabd \ud504\ub85c\uc81d\ud2b8 \ubaa9\ub85d\uc744 \ub04c\uc5b4\uc11c \uc21c\uc11c\ub97c \uc815\ud560 \uc218 \uc788\uc5b4\uc694", "\uc704\ucabd \uac00\uc6b4\ub370 \uc0ac\uc6a9\ub7c9 \ud45c\uc2dc\ub97c \ube7c\uace0 \uac80\uc0c9 \uc544\uc774\ucf58\ub9cc \ub0a8\uacbc\uc5b4\uc694", "\uc0ac\uc6a9\ub7c9 \ud654\uba74\uc758 \uae00\uc744 \uc904\uc774\uace0 \uc804\uccb4 \uc0ac\uc6a9\ub7c9\uc744 \ud06c\uac8c \ubcf4\uc5ec\uc918\uc694. Claude \u00b7 Codex \ud0ed\uc774 \ubc14\ub85c \ubc14\ub00c\uc5b4\uc694", "\ud504\ub85c\uc81d\ud2b8 \ud654\uba74\uc5d0 \uc774\ubbf8 \uc4f0\uace0 \uc788\ub294 \ud504\ub85c\uc81d\ud2b8\uac00 \ubcf4\uc5ec\uc694", "\ud648\uc758 \uc0ac\uc6a9\ub7c9 \ud5c8\ub77d \uce74\ub4dc\ub97c [\ud648\uc5d0\uc11c \uc228\uae30\uae30]\ub85c \uce58\uc6b8 \uc218 \uc788\uc5b4\uc694. \uc0ac\uc6a9\ub7c9 \ud654\uba74\uc5d0\uc11c \ub2e4\uc2dc \ud5c8\ub77d\ud560 \uc218 \uc788\uc5b4\uc694", "\uba54\ub274 \uace0\ub974\uae30\uc5d0\uc11c \ub298 \ubcf4\uc774\ub294 \"\uc124\uc815\" \uc904\uc744 \ube90\uc5b4\uc694", "\ud0a4 \uc785\ub825 \uce78 \uae00\uaf34\uc744 \ub2e4\ub978 \uae00\uacfc \ub9de\ucdc4\uc5b4\uc694", "\ud3f0 \uc5f0\uacb0\uc5d0\uc11c \ud0a4\uac00 \uc5c6\uc744 \ub54c 4\ub2e8\uacc4 \uc774\ub984\uc774 \"\ud0a4 \uc785\ub825\"\uc73c\ub85c \ub098\uc640\uc694", "\ub0b4 \ucc28\ub840 \uc704 \ubc84\ud2bc\uc774 \uc798\ub9ac\uc9c0 \uc54a\uc544\uc694", "\uacb0\uacfc\ubb3c \ubb36\uc74c \uc81c\ubaa9\uc758 \"\ud655\uc778 N\" \ud45c\uc2dc\uac00 \ub450 \uc904\ub85c \uaebe\uc774\uc9c0 \uc54a\uc544\uc694", "\uc791\uc740 \ubc84\ud2bc\uc744 \ub204\ub974\uae30 \uc27d\uac8c \ud0a4\uc6e0\uc5b4\uc694"], "known_issues": ["\ud504\ub85c\uc81d\ud2b8 \uc21c\uc11c\ub294 \uae30\uae30\ub9c8\ub2e4 \ub530\ub85c \uc800\uc7a5\ub418\uace0, \ub9c8\uc6b0\uc2a4\ub85c\ub9cc \ub04c \uc218 \uc788\uc5b4\uc694", "Cinema 4D \ub80c\ub354\ub294 \uc2e4\uc81c \ud504\ub85c\uadf8\ub7a8\uc73c\ub85c \ub05d\uae4c\uc9c0 \ub3cc\ub824 \ubcf4\uc9c0 \ubabb\ud588\uc5b4\uc694", "\uc601\uc5b4 \ud654\uba74\uc740 \uc544\uc9c1 \uc77c\ubd80\ub9cc \ubc88\uc5ed\ub3fc \uc788\uc5b4\uc694"], "sig": "10Ao6_RjEHwzGqFiHVD7bDK3bRGiCGBXTM4FqwtGmB4zHidD41hVAwUcQ6Sie2gXDsaFU0zt1Tfv1BHaGHvGCw"}